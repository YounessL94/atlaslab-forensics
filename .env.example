# Public (inlined at build time — set in Vercel BEFORE building)
NEXT_PUBLIC_SITE_URL=https://forensics.atlaslab.io
NEXT_PUBLIC_SITE_NAME=Atlas Forensics
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server secrets (never commit real values)
# Hive issues one API key per project: image (AI-generated media) and text (AI-generated text).
# HIVE_API_KEY is used as fallback for both.
HIVE_IMAGE_API_KEY=
HIVE_TEXT_API_KEY=
HIVE_API_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random string, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=
GOOGLE_SITE_VERIFICATION=

# Optional abuse/cost caps (defaults shown)
DAILY_IP_LIMIT=40
DAILY_GLOBAL_LIMIT=3000

# Local dev only: deterministic fake results when no Hive key (ignored in production)
# HIVE_MOCK=1
